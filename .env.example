# Copy to .env and fill in. `.env` is git-ignored: never commit real values.
#
# Supabase is provisioned by Lovable Cloud; these come from that project.
# The VITE_-prefixed pair is injected into the browser bundle on purpose, so
# only ever put the PUBLISHABLE key there — it is safe in a client, and RLS is
# what actually protects the data.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix either of these with VITE_, and never read them
# outside a .server.ts module or a route handler.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely (see client.server.ts).
# LOVABLE_API_KEY bills the AI gateway.
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=

# Optional: overrides the model the narrators run on.
#
# GM_MODEL covers Job turns and the I.P. judgement. LIFE_MODEL covers Life and
# falls back to GM_MODEL when it is unset, which is what Life read before it had
# an override of its own — so setting GM_MODEL alone still steers both loops.
# Set them apart to run Life and Jobs on different models; they are separate
# prompts on purpose, and until LIFE_MODEL existed that separation could not be
# tested.
#
# Both are also what `bun run eval` asks for. See evals/README.md.
GM_MODEL=
LIFE_MODEL=
