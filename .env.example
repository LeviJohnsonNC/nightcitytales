# Copy to .env and fill in. `.env` is git-ignored: never commit real values.
#
# Supabase is provisioned by Lovable Cloud; these come from that project.
# The VITE_-prefixed pair is injected into the browser bundle on purpose, so
# only ever put the PUBLISHABLE key there — it is safe in a client, and RLS is
# what actually protects the data.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix either of these with VITE_, and never read them
# outside a .server.ts module or a route handler.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely (see client.server.ts).
# LOVABLE_API_KEY bills the AI gateway.
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=

# Optional: overrides the model used for GM, Life and I.P. turns.
GM_MODEL=
