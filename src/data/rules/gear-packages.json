  "_source": {
    "book": "Cyberpunk RED Core Rulebook",
    "publisher": "R. Talsorian Games",
    "pages": "98-99 (Weapons/Armor), 103 (Outfit and Gear)",
    "note": "Fixed packages for Streetrat and Edgerunner. Complete Package buys everything individually instead."
  },
  "_extraction": {
    "method": "The source prints these as five-column tables that do not linearise cleanly \u2014 Medtech's outfit line appears interleaved mid-gear-list, so no structural split is reliable. Assignments were made by reading the printed columns, then every item string was verified to exist in the source text, and the Solo package was checked against the book's own worked 'Jay's Solo' example (exact match).",
    "confidence": "Confirmed for all ten roles against the printed Weapons/Armor tables (2026-08-21). The two previously flagged rows \u2014 Medtech's Bulletproof Shield and Fixer's duplicated Heavy/Very Heavy Pistol choice \u2014 both read as printed and are correct."
  },
  "_rules": {
    "appliesTo": ["streetrat", "edgerunner"],
    "freeEurobucks": 500,
    "unspentKept": true,
    "choiceRule": "Where an entry is a `choice`, the player picks exactly ONE option. Never both.",
    "armorNote": "Every Role receives Light Armorjack Body Armor and Head Armor at SP11. Track current SP separately from base SP so ablation works in play.",
    "cyberwareNote": "NOT IN THIS FILE. The core rulebook does not print starting cyberware packages for Streetrat/Edgerunner \u2014 those Characters begin with no cyberware, so no Humanity Loss applies at creation. Complete Package Characters buy cyberware from the 2,550eb budget and take Humanity Loss then.",
    "outfitNote": "Outfit strings are printed as Fashion-style groupings with quantities inline (e.g. 'Leisurewear: Footwear x2, Jacket x3'). Kept as printed rather than exploded into items \u2014 the Fashion catalog defines the pieces."
  },
  "_schema": {
    "entry": "{ item: string, qty: number }  OR  { choice: string[] }",
    "note": "Every array element is one or the other. Check for a `choice` key before reading `item`."
  },
